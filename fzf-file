#!/bin/bash

# # debug
# set -o xtrace

declare SRCDIR
SRCDIR=$(dirname $(readlink -e $0))

if [[ $1 =~ -h|--help ]]; then
    man -l $SRCDIR/help.1
    exit
fi

# QUERY is optionally set externally: QUERY='foo bar' fzf-file
declare QUERY
if [[ ! -t 0 ]]; then		# stdin not attached to a tty
    unset FZF_DEFAULT_COMMAND
else
    FZF_DEFAULT_COMMAND="rg --files $@" # support multiple directories
fi
declare FZF_DEFAULT_OPTS="--ansi --header-first --exact"
declare BAT="bat --style=full --color=always --paging=always" # --lessopen (has to be enabled at compile time)

declare VIEWER HEADER WIDTH
if [[ -f $(which bat 2> /dev/null) ]]; then
    HEADER='~4'
    if [[ -n $QUERY ]]; then
	VIEWER="$BAT --pager 'less \"+/$QUERY\"'"
    else
	VIEWER="$BAT"
    fi
else
    if [[ -n $QUERY ]]; then
	VIEWER="less -NS '+/$QUERY'"
    else
	VIEWER="less -NS"
    fi
fi
[[ $COLUMNS -gt 160 ]] && WIDTH=",60%"

# terminal graphics protocol; deps: kitty, magick, mediainfo
declare IMGVIEWER SVGVIEWER
if [[ -f $(which kitten 2> /dev/null) ]]; then
    xfmode=$( 2>&1 kitten icat --detect-support )
    tgp=$?
fi

if [[ $tgp -eq 0 ]]; then
    # FIXME: can we write a function, and export?  How do we get FZF_*
    # env variables expanded later?
    declare imgsize='${FZF_PREVIEW_COLUMNS}x$(( ${FZF_PREVIEW_LINES} - 2 ))'
    IMGVIEWER="identify {}; echo; kitten icat --clear --transfer-mode=$xfmode --stdin=no --fit both --loop 3 --place=$imgsize@0x0 {}"
    SVGVIEWER=$IMGVIEWER
else
    IMGVIEWER="mediainfo {}"
    SVGVIEWER="$VIEWER {}"
fi

function quote() {
    IFS=','
    echo "«${*}»" # | fold -w$COLUMNS
}

declare -a bindings=(
    "F1: help"
    "C-s: search current files"
    "M-a: print & quit"
    "C-l: cancel search"
    "RET: view"
    "M-RET: open"
)
declare HINT
HINT=$(quote "${bindings[@]}")

fzf --prompt='> ' \
    --header "$HINT" \
    --preview "case \${ file --mime-type {} | cut -d' ' -f2;} in image/svg*) $SVGVIEWER;; image/*) $IMGVIEWER;; *) $VIEWER {}; esac" \
    --preview-window "border-left:${HEADER}${WIDTH}" \
    --bind "focus:clear-screen" \
    --bind "f1:execute(man -l $SRCDIR/help.1 || true)" \
    --bind "enter:execute($VIEWER {1})" \
    --bind "alt-enter:execute($EDITOR {1})" \
    --bind "ctrl-s:select-all+execute(cat {*f} | QUERY='${QUERY}' fzf-search || true)+deselect-all" \
    --bind "alt-a:accept" \
    --bind "ctrl-l:cancel"
